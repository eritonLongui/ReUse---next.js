# String de conexão com o banco PostgreSQL (Supabase, Neon, Railway, local, etc)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reuse_db?schema=public

# Chave secreta para cookies de sessão e JWT
SESSION_SECRET=reuse-app-secret-super-seguro-fiap-2026

# IBM watsonx Orchestrate — Agente A2A
# API Key do IBM Cloud IAM (usada para gerar bearer token via https://iam.cloud.ibm.com/identity/token)
WATSONX_ORCHESTRATE_API_KEY=sua-api-key-ibm-cloud

# URL completa do endpoint A2A do agente publicado no ambiente Live (opcional, padrão configurado no código)
WATSONX_ORCHESTRATE_AGENT_URL=https://api.au-syd.watson-orchestrate.cloud.ibm.com/instances/683cf7ca-4458-4c3b-b7df-c6d7f29b2e24/v1/orchestrate/A2A/agents/4c21d327-f8e5-401e-92c7-651e3b6428e1/environment/770cbc64-b448-4ecc-a9bf-6a8c7bccaf51
